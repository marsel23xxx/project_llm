# Salin ke .env lalu isi nilainya: cp .env.example .env

# Di server: ENVIRONMENT=production dan FRONTEND_ORIGIN=https://domainmu
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
# false = pendaftaran akun baru ditutup
REGISTRATION_OPEN=true

POSTGRES_USER=analyst
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=analyst

# Buat dengan: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# local  = gratis, semua jawaban dari LLM lokal (pakai ini selama development)
# hybrid = tugas ringan (merangkum) ke lokal, tugas berat (SQL, kode, dokumen) ke API
# api    = semua ke API, lokal hanya sebagai cadangan (paling cepat)
LLM_MODE=local
LOCAL_LLM_FILE=qwen2.5-coder-3b-instruct-q4_k_m.gguf

# --- API LLM (opsional). Kosong = gratis, hanya LLM lokal. ---
# DeepSeek (murah, format OpenAI). Isi key dari platform.deepseek.com, sistem prabayar.
# Catatan privasi: nama kolom, 3 baris contoh, dan kutipan dokumen dikirim ke server penyedia.
REMOTE_LLM_API_KEY=
REMOTE_LLM_BASE_URL=https://api.deepseek.com
# deepseek-flash (murah, cepat) atau deepseek-v4-pro (lebih kuat, ~4x lebih mahal)
REMOTE_LLM_MODEL=deepseek-flash
# true = tanpa "thinking": lebih murah dan cepat, cukup untuk SQL dan jawaban singkat
REMOTE_LLM_DISABLE_THINKING=true

# Claude (dari console.anthropic.com, prabayar). Jika diisi, Claude dipakai menggantikan DeepSeek.
ANTHROPIC_API_KEY=
# Pilihan: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Kosongkan untuk claude-haiku-4-5
CLAUDE_EFFORT=medium
DAILY_QUESTION_QUOTA=20

# Port backend di host (ganti jika 8000 sudah dipakai)
BACKEND_PORT=8000
FRONTEND_PORT=3000
